# ──────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Alejandría UPC (Frontend React + Vite)
# 1. Copia este archivo como .env.local dentro de frontend/ (ignorado por Git).
# 2. Ajusta los valores según cómo quieras correr el frontend.
# 3. Reinicia "npm run dev" cada vez que modifiques .env.local.
# ──────────────────────────────────────────────────────────────────────────────

# URL base del backend Spring Boot (sin "/" al final)
VITE_API_URL=http://localhost:8080/api

# Modo de datos:
#   false -> conecta contra la API real de Spring Boot con Axios
#   true  -> usa datos simulados locales en src/mocks (sin backend; valor por defecto si se omite)
VITE_USE_MOCK=false

# Retardo simulado en milisegundos cuando VITE_USE_MOCK=true (útil para probar Skeletons)
VITE_MOCK_DELAY=400
