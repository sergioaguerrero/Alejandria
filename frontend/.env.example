# ─────────────────────────────────────────────────────────────
# Environment variables — Alejandría (frontend)
# Copy this file as .env.local and adjust the values.
# ─────────────────────────────────────────────────────────────

# Base URL of the Spring Boot backend (without trailing slash)
VITE_API_URL=http://localhost:8080/api

# true  → the app uses the example data from src/mocks (no backend needed)
# false → the app calls the real API with Axios
VITE_USE_MOCK=true

# Simulated delay of the mock responses, in milliseconds.
# Useful to see the loading states (Skeleton) in the demo.
VITE_MOCK_DELAY=400
