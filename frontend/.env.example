# ─────────────────────────────────────────────────────────────
# Variables de entorno — Alejandría UPC (frontend)
# Copia este archivo como .env.local y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# URL base del backend Spring Boot (sin barra final)
VITE_API_URL=http://localhost:8080/api

# true  → la app usa los datos de ejemplo de src/mocks (no necesita backend)
# false → la app llama a la API real con Axios
VITE_USE_MOCK=true

# Retardo simulado de las respuestas mock, en milisegundos.
# Sirve para ver los estados de carga (Skeleton) en la demo.
VITE_MOCK_DELAY=400
